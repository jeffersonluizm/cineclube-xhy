# ---------- Banco de dados ----------
# Local: mongodb://localhost:27017/cineclube_xhy
# Produção (MongoDB Atlas): mongodb+srv://usuario:senha@cluster.mongodb.net/cineclube_xhy
MONGODB_URI=mongodb://localhost:27017/cineclube_xhy

PORT=3001
# Em produção use "production": desliga o MongoDB embutido de fallback e exige os segredos abaixo
NODE_ENV=development

# ---------- Segurança ----------
# Senha usada pelo editor para entrar em /admin
ADMIN_PASSWORD=defina-uma-senha
# Segredo aleatório usado para assinar os tokens de sessão
# (gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=defina-um-segredo-aleatorio

# Origens permitidas pelo CORS, separadas por vírgula (sem barra no final)
# Produção: https://seudominio.com.br,https://www.seudominio.com.br
FRONTEND_URL=http://localhost:3000

# ---------- Imagens ----------
# Opcional em desenvolvimento, OBRIGATÓRIO em hospedagens com disco efêmero (Render, Vercel...).
# Sem esta variável as imagens vão para backend/uploads/.
# Copie de: https://console.cloudinary.com  →  "API Environment variable"
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_FOLDER=cineclube-xhy
